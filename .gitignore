# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite data (runtime DB, uploads, full 66MB ECDICT) — but the committed
# test fixtures stay: the import/gate suites read them, CI included
data/*
!data/test-fixtures/
!data/speaking-bank/
!data/writing-bank/
!data/ieltscb-samples/
# isolated gate databases (verify-mock-bypass and future step gates) are
# throwaway artifacts — never commit them
data/test-fixtures/*.db
data/test-fixtures/*.db-wal
data/test-fixtures/*.db-shm
# pre-migration rehearsal snapshots are equally throwaway
data/test-fixtures/*.snapshot

# but keep the example env documented
!.env.local.example

# audio corpus (~1GB, regenerable via scripts/db:audio + db:cambridge + c18 copy from D:\雅思\ielts-repos)
/public/audio

# local tooling artifacts
/.mimosa/
/.playwright-mcp/

# mimosa scanner runtime state
.mimosa/
src/.mimosa/
**/.mimosa/
dist/
*.tsbuildinfo
