#!/bin/sh
# Local CI gate — run the full offline verification suite before any push.
# Configure once per clone: git config core.hooksPath .githooks
# Skip for a one-off: git push --no-verify
echo "[pre-push] running npm run verify:all (lint + smoke + pm + engine + rotation + loop + writing-gate) ..."
npm run verify:all || {
  echo "[pre-push] VERIFY FAILED — push aborted. Fix the failures or use --no-verify consciously."
  exit 1
}
echo "[pre-push] all green."
